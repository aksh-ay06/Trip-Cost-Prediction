variable "project_id" {
  description = "GCP project ID"
  type        = string
}

variable "region" {
  description = "GCP region"
  type        = string
  default     = "us-central1"
}

variable "credentials_file" {
  description = "Path to GCP service account key JSON"
  type        = string
  default     = "../keys/my_keys.json"
}
