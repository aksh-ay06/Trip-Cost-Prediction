# Copy to .env and fill in. .env is gitignored.

# GCP
GCP_PROJECT=your-gcp-project-id
# Absolute host path to the folder holding the service account key (my_keys.json).
# Kestra mounts it into each pipeline task container.
KEYS_DIR=/absolute/path/to/keys

# Kestra backend database
POSTGRES_USER=kestra
POSTGRES_PASSWORD=changeme
POSTGRES_DB=kestra

# Kestra UI login (password needs 8+ characters, an uppercase letter, and a number)
KESTRA_ADMIN_USER=admin@example.com
KESTRA_ADMIN_PASSWORD=ChangeMe123
